###############################################################

### MAIN API

### GET
GET {{baseUrl}}/products

### Get PRODUCT ID
GET {{baseUrl}}/products/{{id}}

### POST
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "iPhone",
  "price": 1000,
  "stock": 5
}

### UPDATE
PUT {{baseUrl}}/products/{{id}}
Content-Type: application/json

{
  "name": "iPhone 15 Pro",
  "price": 1200,
  "stock": 10
}

### DELETE
DELETE {{baseUrl}}/products/{{id}}

###############################################################

### BONUS

### DEFAULT PAGINATION
GET {{baseUrl}}/products
?page={{page}}

### CURSOR PARINATION
GET {{baseUrl}}/products
?cursor={{cursor}}

###############################################################

### TEST

### LIMIT FAIL
GET {{baseUrl}}/products?limit=abc

### LIMIT SUCCESS
GET {{baseUrl}}/products?limit=10
